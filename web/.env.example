# Copy to .env.local (development) or set on the server (production).

# Admin login for /responses
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs the admin session cookie. Any long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the database (feedback.db) and uploaded photos are kept.
# Defaults to ./data inside this folder. Back this folder up.
# DATA_DIR=/var/lib/kotu-feedback

# Only if the site is served over plain HTTP (not recommended):
# COOKIE_SECURE=false
